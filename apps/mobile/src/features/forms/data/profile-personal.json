{
  "formId": "profile-personal",
  "title": "Personal Information",
  "description": "This information will be used to pre-fill forms and process your TIE application.",
  "fields": [
    {
      "id": "firstName",
      "label": "First Name",
      "type": "text",
      "required": true,
      "placeholder": "Enter your first name"
    },
    {
      "id": "lastName",
      "label": "Last Name",
      "type": "text",
      "required": true,
      "placeholder": "Enter your last name"
    },
    {
      "id": "secondLastName",
      "label": "Second Last Name",
      "type": "text",
      "required": false,
      "placeholder": "Enter your second last name (optional)"
    },
    {
      "id": "dateOfBirth",
      "label": "Date of Birth",
      "type": "date",
      "required": true,
      "placeholder": "Your date of birth"
    },
    {
      "id": "nationality",
      "label": "Nationality",
      "type": "text",
      "required": true,
      "placeholder": "Your country of citizenship"
    },
    {
      "id": "documentType",
      "label": "Document Type",
      "type": "select",
      "required": true,
      "options": [
        {
          "label": "NIE",
          "value": "nie"
        },
        {
          "label": "Passport",
          "value": "passport"
        }
      ]
    },
    {
      "id": "documentNumber",
      "label": "Document Number",
      "type": "text",
      "required": true,
      "placeholder": "e.g., X1234567A or AB123456"
    },
    {
      "id": "phoneNumber",
      "label": "Phone Number",
      "type": "phone",
      "required": true
    },
    {
      "id": "address",
      "label": "Registered Address",
      "type": "text",
      "required": true,
      "placeholder": "Street, building, floor, apartment",
      "helperText": "This is where you are officially registered (empadronado). We use this address for appointments and tax forms, even if you live somewhere else."
    },
    {
      "id": "city",
      "label": "City",
      "type": "text",
      "required": true,
      "placeholder": "e.g., Barcelona"
    },
    {
      "id": "postalCode",
      "label": "Postal Code",
      "type": "text",
      "required": true,
      "placeholder": "e.g., 08001"
    },
    {
      "id": "hasEmpadronamiento",
      "label": "Do you already have empadronamiento?",
      "type": "select",
      "required": true,
      "options": [
        {
          "label": "No",
          "value": "no"
        },
        {
          "label": "Yes",
          "value": "yes"
        }
      ]
    },
    {
      "id": "empadronamientoIssuedAt",
      "label": "Empadronamiento certificate date",
      "type": "date",
      "required": true,
      "placeholder": "When the certificate was issued",
      "helperText": "For TIE, the certificate must usually be issued within the last 90 days.",
      "dependsOn": {
        "fieldId": "hasEmpadronamiento",
        "value": "yes"
      }
    }
  ]
}
